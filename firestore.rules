rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isOwner(teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;
    }

    function isAdmin(teamId) {
      return isMember(teamId)
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['Owner', 'Admin'];
    }

    function canContribute(teamId) {
      return isMember(teamId)
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['Owner', 'Admin', 'Member'];
    }

    function commentEmailMatchesAuth() {
      return request.resource.data.authorEmail == (
        'email' in request.auth.token ? request.auth.token.email : ''
      );
    }

    function validInviteRole(teamId, role) {
      return role in ['Admin', 'Member', 'Viewer']
        && (isOwner(teamId) || (isAdmin(teamId) && role in ['Member', 'Viewer']));
    }

    function validCreatedRecord() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validTask(teamId) {
      return request.resource.data.keys().hasAll([
          'title', 'status', 'priority', 'ownerUid', 'dueAt', 'timezone', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'status', 'priority', 'ownerUid', 'projectId',
          'startDate', 'dueAt', 'timezone', 'tags', 'meetingStart', 'meetingEnd',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.status in ['Backlog', 'Planned', 'In Progress', 'Blocked', 'Completed', 'Cancelled']
        && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
        && request.resource.data.ownerUid is string
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid))
        && request.resource.data.dueAt is timestamp
        && request.resource.data.timezone is string
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string
            && request.resource.data.description.size() <= 5000))
        && (!('meetingStart' in request.resource.data)
          || (request.resource.data.meetingStart is timestamp
            && 'meetingEnd' in request.resource.data))
        && (!('meetingEnd' in request.resource.data)
          || (request.resource.data.meetingEnd is timestamp
            && 'meetingStart' in request.resource.data))
        && (!('meetingStart' in request.resource.data)
          || request.resource.data.meetingEnd > request.resource.data.meetingStart)
        && validCreatedRecord();
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'timezone', 'locale', 'timeFormat', 'country', 'region',
          'timezoneSource', 'timezoneConfirmed', 'teamId', 'teamIds', 'updatedAt'
        ])
        && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 80))
        && (!('region' in request.resource.data) || (request.resource.data.region is string && request.resource.data.region.size() <= 80))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.resource.data.recipientUid == userId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.teamId is string
          && isMember(request.resource.data.teamId)
          && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/members/$(userId))
          && request.resource.data.type in ['task_assigned', 'task_comment', 'task_mention']
          && request.resource.data.targetType == 'task'
          && request.resource.data.targetId is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 160
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 500
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'teamId', 'recipientUid', 'type', 'title', 'body', 'actorUid',
            'targetType', 'targetId', 'commentId', 'read', 'createdAt'
          ])
          && existsAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId))
          && ((request.resource.data.type == 'task_assigned'
              && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)).data.ownerUid == userId)
            || (request.resource.data.type == 'task_comment'
              && (getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)).data.ownerUid == userId
                || getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)).data.createdBy == userId)
              && request.resource.data.commentId is string
              && existsAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId))
              && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId)).data.authorUid == request.auth.uid)
            || (request.resource.data.type == 'task_mention'
              && request.resource.data.commentId is string
              && existsAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId))
              && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId)).data.authorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId)).data.mentionedUids is list
              && userId in getAfter(/databases/$(database)/documents/teams/$(request.resource.data.teamId)/tasks/$(request.resource.data.targetId)/comments/$(request.resource.data.commentId)).data.mentionedUids));
        allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.recipientUid == userId
          && resource.data.read == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    match /teams/{teamId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'timezone', 'defaultTimezone', 'companyProfileComplete',
          'legalName', 'website', 'industry', 'stage', 'country', 'region', 'profileCompletedAt', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && (!('defaultTimezone' in request.resource.data) || request.resource.data.defaultTimezone is string)
        && (!('companyProfileComplete' in request.resource.data) || request.resource.data.companyProfileComplete is bool)
        && request.resource.data.createdAt == request.time;
      allow read: if isMember(teamId);
      allow update: if isMember(teamId)
        && isAdmin(teamId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'timezone', 'defaultTimezone', 'companyProfileComplete', 'legalName',
          'website', 'industry', 'stage', 'country', 'region', 'profileCompletedAt', 'companyLogoPath', 'companyLogoUpdatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && (!('legalName' in request.resource.data) || (request.resource.data.legalName is string && request.resource.data.legalName.size() <= 160))
        && (!('website' in request.resource.data) || (request.resource.data.website is string && request.resource.data.website.size() <= 200))
        && (!('industry' in request.resource.data) || (request.resource.data.industry is string && request.resource.data.industry.size() <= 100))
        && (!('stage' in request.resource.data) || (request.resource.data.stage is string && request.resource.data.stage.size() <= 40))
        && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 80))
        && (!('region' in request.resource.data) || (request.resource.data.region is string && request.resource.data.region.size() <= 80))
        && (!('defaultTimezone' in request.resource.data) || request.resource.data.defaultTimezone is string)
        && (!('companyProfileComplete' in request.resource.data) || request.resource.data.companyProfileComplete is bool)
        && (!('companyLogoPath' in request.resource.data) || (request.resource.data.companyLogoPath is string && request.resource.data.companyLogoPath.size() <= 300))
        && (!('companyLogoUpdatedAt' in request.resource.data) || request.resource.data.companyLogoUpdatedAt == request.time)
        && (!('profileCompletedAt' in request.resource.data) || request.resource.data.profileCompletedAt == request.time);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(teamId);
        allow create: if (isOwner(teamId)
          && memberId == request.auth.uid
          && request.resource.data.uid == memberId
          && request.resource.data.role == 'Owner'
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'timezone', 'country', 'region', 'title', 'joinedAt']))
          || (signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == memberId
          && request.resource.data.joinedAt == request.time
          && exists(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId))
          && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.status == 'pending'
          && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.expiresAt > request.time
          && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.email == request.auth.token.email
          && request.auth.token.email_verified == true
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.acceptedBy == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.inviteId)).data.role
          && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'timezone', 'country', 'region', 'title', 'joinedAt', 'inviteId']));
        allow update: if (isAdmin(teamId)
          && memberId != get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'role', 'timezone', 'country', 'region', 'title'
          ])
          && request.resource.data.role in ['Admin', 'Member', 'Viewer']
          && (isOwner(teamId)
            || (resource.data.role in ['Member', 'Viewer'] && request.resource.data.role in ['Member', 'Viewer']))
          && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80)))
          || (signedIn()
            && memberId == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'timezone', 'country', 'region', 'displayName', 'title',
              'availabilityStatus', 'workingDays', 'workdayStart', 'workdayEnd'
            ])
            && (!('timezone' in request.resource.data) || request.resource.data.timezone is string)
            && (!('country' in request.resource.data) || (request.resource.data.country is string && request.resource.data.country.size() <= 80))
            && (!('region' in request.resource.data) || (request.resource.data.region is string && request.resource.data.region.size() <= 80))
            && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 80))
            && (!('availabilityStatus' in request.resource.data) || request.resource.data.availabilityStatus in ['Auto', 'Available', 'Busy', 'Focus time', 'Away'])
            && (!('workingDays' in request.resource.data) || (request.resource.data.workingDays is list && request.resource.data.workingDays.size() > 0 && request.resource.data.workingDays.size() <= 7))
            && (!('workdayStart' in request.resource.data) || (request.resource.data.workdayStart is string && request.resource.data.workdayStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
            && (!('workdayEnd' in request.resource.data) || (request.resource.data.workdayEnd is string && request.resource.data.workdayEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))));
        allow delete: if isAdmin(teamId)
          && memberId != request.auth.uid
          && memberId != get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid
          && (isOwner(teamId) || resource.data.role in ['Member', 'Viewer']);
      }

      match /invites/{inviteId} {
        allow read: if isAdmin(teamId)
          || (signedIn() && request.auth.token.email == resource.data.email);
        allow create: if isAdmin(teamId)
          && inviteId.matches('^[a-f0-9]{64}$')
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() <= 254
          && request.resource.data.email == request.resource.data.email.lower()
          && validInviteRole(teamId, request.resource.data.role)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
          && request.resource.data.keys().hasOnly(['email', 'role', 'status', 'createdBy', 'createdAt', 'expiresAt']);
        allow update: if resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedBy', 'acceptedAt', 'revokedBy', 'revokedAt'
          ])
            && ((request.resource.data.status == 'accepted'
              && signedIn()
              && request.auth.token.email_verified == true
              && request.auth.token.email == resource.data.email
              && resource.data.expiresAt > request.time
              && request.resource.data.acceptedBy == request.auth.uid
              && request.resource.data.acceptedAt == request.time
              && getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.inviteId == inviteId)
            || (request.resource.data.status == 'revoked'
              && validInviteRole(teamId, resource.data.role)
              && request.resource.data.revokedBy == request.auth.uid
              && request.resource.data.revokedAt == request.time));
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isMember(teamId);
        allow create: if canContribute(teamId)
          && validTask(teamId)
          && (isAdmin(teamId) || request.resource.data.ownerUid == request.auth.uid);
        allow update: if canContribute(teamId)
          && (isAdmin(teamId)
            || resource.data.ownerUid == request.auth.uid
            || resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'googleCalendarEventId', 'meetingUrl', 'calendarEventUrl', 'meetingStart', 'meetingEnd', 'updatedAt'
            ]))
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'status', 'priority', 'ownerUid', 'projectId',
            'startDate', 'dueAt', 'timezone', 'tags', 'googleCalendarEventId', 'meetingUrl', 'calendarEventUrl', 'meetingStart', 'meetingEnd', 'completedAt', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'status', 'priority', 'ownerUid', 'projectId',
            'startDate', 'dueAt', 'timezone', 'tags', 'googleCalendarEventId', 'meetingUrl', 'calendarEventUrl', 'meetingStart', 'meetingEnd', 'completedAt', 'updatedAt'
          ])
          && request.resource.data.status in ['Backlog', 'Planned', 'In Progress', 'Blocked', 'Completed', 'Cancelled']
          && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
          && request.resource.data.dueAt is timestamp
          && request.resource.data.timezone is string
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid))
          && (!('description' in request.resource.data)
            || (request.resource.data.description is string && request.resource.data.description.size() <= 5000))
          && (!('meetingUrl' in request.resource.data)
            || (request.resource.data.meetingUrl is string
              && (request.resource.data.meetingUrl == '' || request.resource.data.meetingUrl.matches('https://meet\\.google\\.com/.*'))))
          && (!('googleCalendarEventId' in request.resource.data)
            || (request.resource.data.googleCalendarEventId is string && request.resource.data.googleCalendarEventId.size() <= 1024))
          && (!('calendarEventUrl' in request.resource.data)
            || (request.resource.data.calendarEventUrl is string
              && (request.resource.data.calendarEventUrl == ''
                || request.resource.data.calendarEventUrl.matches('https://(www\\.)?google\\.com/calendar/.*')
                || request.resource.data.calendarEventUrl.matches('https://calendar\\.google\\.com/calendar/.*'))))
          && (!('meetingStart' in request.resource.data)
            || (request.resource.data.meetingStart is timestamp
              && 'meetingEnd' in request.resource.data))
          && (!('meetingEnd' in request.resource.data)
            || (request.resource.data.meetingEnd is timestamp
              && 'meetingStart' in request.resource.data))
          && (!('meetingStart' in request.resource.data)
            || request.resource.data.meetingEnd > request.resource.data.meetingStart)
          && (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);
        allow delete: if canContribute(teamId)
          && (isAdmin(teamId) || resource.data.createdBy == request.auth.uid);

        match /history/{eventId} {
          allow read: if isMember(teamId);
          allow create: if canContribute(teamId)
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.type == 'status_changed'
            && request.resource.data.from in ['Backlog', 'Planned', 'In Progress', 'Blocked', 'Completed', 'Cancelled']
            && request.resource.data.to in ['Backlog', 'Planned', 'In Progress', 'Blocked', 'Completed', 'Cancelled']
            && request.resource.data.from != request.resource.data.to
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['actorUid', 'type', 'from', 'to', 'createdAt']);
          allow update: if false;
          allow delete: if canContribute(teamId)
            && (isAdmin(teamId)
              || get(/databases/$(database)/documents/teams/$(teamId)/tasks/$(taskId)).data.createdBy == request.auth.uid);
        }

        match /comments/{commentId} {
          allow read: if isMember(teamId);
          allow create: if canContribute(teamId)
            && request.resource.data.authorUid == request.auth.uid
            && commentEmailMatchesAuth()
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 5000
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorEmail', 'body', 'parentId', 'mentionedUids', 'createdAt'])
            && (!('mentionedUids' in request.resource.data)
              || (request.resource.data.mentionedUids is list
                && request.resource.data.mentionedUids.size() <= 50))
            && (!('parentId' in request.resource.data)
              || (request.resource.data.parentId is string
                && exists(/databases/$(database)/documents/teams/$(teamId)/tasks/$(taskId)/comments/$(request.resource.data.parentId))));
          allow update: if false;
          allow delete: if canContribute(teamId)
            && (isAdmin(teamId)
              || get(/databases/$(database)/documents/teams/$(teamId)/tasks/$(taskId)).data.createdBy == request.auth.uid);
        }
      }

      match /commitments/{commitmentId} {
        allow read: if isMember(teamId);
        allow create: if canContribute(teamId)
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid))
          && (isAdmin(teamId) || request.resource.data.ownerUid == request.auth.uid)
          && validCreatedRecord()
          && request.resource.data.keys().hasAll(['description', 'status', 'priority', 'ownerUid', 'dueAt', 'timezone', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
            'description', 'status', 'priority', 'ownerUid', 'dueAt', 'timezone',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 1000
          && request.resource.data.status in ['Active', 'Completed', 'Missed', 'Cancelled']
          && request.resource.data.dueAt is timestamp
          && request.resource.data.timezone is string
          && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical'];
        allow update: if canContribute(teamId)
          && (isAdmin(teamId) || resource.data.ownerUid == request.auth.uid)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'description', 'status', 'priority', 'dueAt', 'timezone', 'updatedAt'
          ])
          && request.resource.data.status in ['Active', 'Completed', 'Missed', 'Cancelled']
          && request.resource.data.dueAt is timestamp
          && request.resource.data.timezone is string;
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isMember(teamId);
        allow create: if isAdmin(teamId)
          && validCreatedRecord()
          && request.resource.data.keys().hasAll(['title', 'status', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
            'title', 'status', 'description', 'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && (!('description' in request.resource.data)
            || (request.resource.data.description is string
              && request.resource.data.description.size() <= 5000))
          && request.resource.data.status in ['Active', 'Completed', 'On Hold'];
        allow update: if isAdmin(teamId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'status', 'description', 'updatedAt'
          ])
          && request.resource.data.status in ['Active', 'Completed', 'On Hold'];
        allow delete: if false;
      }

      match /milestones/{milestoneId} {
        allow read: if isMember(teamId);
        allow create: if canContribute(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['Planned', 'In Progress', 'Completed']
          && request.resource.data.priority in ['Low', 'Medium', 'High', 'Critical']
          && request.resource.data.ownerUid is string
          && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.resource.data.ownerUid))
          && request.resource.data.dueAt is timestamp
          && request.resource.data.timezone is string
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'status', 'priority', 'ownerUid', 'dueAt', 'timezone',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 5000));
        allow update: if canContribute(teamId)
          && (isAdmin(teamId) || resource.data.ownerUid == request.auth.uid || resource.data.createdBy == request.auth.uid)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
          && request.resource.data.status in ['Planned', 'In Progress', 'Completed']
          && (!('completedAt' in request.resource.data) || request.resource.data.completedAt == null || request.resource.data.completedAt == request.time);
        allow delete: if false;
      }

      match /weeklyReviews/{reviewId} {
        allow read: if isMember(teamId);
        allow create: if canContribute(teamId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.weekStart is string
          && request.resource.data.weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && reviewId == request.auth.uid + '_' + request.resource.data.weekStart
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly(['ownerUid', 'weekStart', 'wins', 'misses', 'blockers', 'priorities', 'reflection', 'createdAt', 'updatedAt'])
          && request.resource.data.wins is string && request.resource.data.wins.size() <= 4000
          && request.resource.data.misses is string && request.resource.data.misses.size() <= 4000
          && request.resource.data.blockers is string && request.resource.data.blockers.size() <= 4000
          && request.resource.data.priorities is string && request.resource.data.priorities.size() <= 4000
          && request.resource.data.reflection is string && request.resource.data.reflection.size() <= 4000;
        allow update: if canContribute(teamId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.weekStart == resource.data.weekStart
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wins', 'misses', 'blockers', 'priorities', 'reflection', 'updatedAt'])
          && request.resource.data.wins is string && request.resource.data.wins.size() <= 4000
          && request.resource.data.misses is string && request.resource.data.misses.size() <= 4000
          && request.resource.data.blockers is string && request.resource.data.blockers.size() <= 4000
          && request.resource.data.priorities is string && request.resource.data.priorities.size() <= 4000
          && request.resource.data.reflection is string && request.resource.data.reflection.size() <= 4000;
        allow delete: if false;

        match /versions/{versionId} {
          allow read: if isMember(teamId) && get(/databases/$(database)/documents/teams/$(teamId)/weeklyReviews/$(reviewId)).data.ownerUid == request.auth.uid;
          allow create: if canContribute(teamId)
            && get(/databases/$(database)/documents/teams/$(teamId)/weeklyReviews/$(reviewId)).data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.savedAt == request.time
            && request.resource.data.values is map
            && request.resource.data.keys().hasOnly(['ownerUid', 'savedAt', 'values']);
          allow update, delete: if false;
        }
      }

      match /activity/{activityId} {
        allow read: if isMember(teamId);
        allow create: if canContribute(teamId)
          && request.resource.data.actor == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasAll(['type', 'title', 'actor', 'entityId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['type', 'title', 'detail', 'actor', 'entityId', 'createdAt'])
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 1000
          && (!('detail' in request.resource.data)
            || (request.resource.data.detail is string
              && request.resource.data.detail.size() <= 2000));
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
